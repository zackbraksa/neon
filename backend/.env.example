# Generate independently: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
API_TOKEN=
ENCRYPTION_KEY=
HOST=127.0.0.1
PORT=8080
DATABASE_PATH=./data/openchat.sqlite
# Optional. Only list the private socket IPs of proxies that overwrite X-Neon-Client-IP.
TRUSTED_PROXY_IPS=

# Optional. Supply all four to enable push. Do not commit the .p8 file.
APNS_TEAM_ID=
APNS_KEY_ID=
# App bundle ID, for example com.example.neon
APNS_TOPIC=
APNS_KEY_FILE=
# sandbox for development builds, production for distribution builds.
APNS_ENVIRONMENT=sandbox
